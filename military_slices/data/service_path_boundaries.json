  "anchor_model": {
    "human_anchor": "The user-declared outcome being pursued now. If absent, the only active objective is to establish the smallest useful anchor.",
    "path_target_state": "The next bounded transition milestone on the service-aware path.",
    "rule": "A task must map to both the human anchor (or anchor-establishment task) and the next path target state. Process compliance alone is not the user objective."
  }
}